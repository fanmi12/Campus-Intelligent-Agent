# 复制本文件为 .env.local（本地开发）或 .env（服务器部署），再填入自己的配置。
# 不填 LLM_API_KEY 时进入「演示模式」：不调用大模型，用模拟回复跑通整个界面。
#
# 我们当前的组合：DeepSeek 负责对话和识图，硅基流动负责嵌入和重排。

# ============ 对话模型（任意 OpenAI 兼容接口） ============
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 模型名要填接口里的 ID（不是网页上的显示名），可用 GET {LLM_BASE_URL}/models 查询
LLM_MODEL=deepseek-flash
# 附加到请求里的参数（JSON）。DeepSeek V4 默认先"思考"再回答，首字要等 2～7 秒；
# 校园问答依据检索到的资料作答，不需要长推理，关掉后首字约 0.5 秒。
# 其他服务商按各自文档填，例如阿里云百炼的 Qwen3：{"enable_thinking":false}
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ============ 实时联网（DeepSeek Search / Fetch，独立于知识库检索） ============
# 默认开启；对话服务为 https://api.deepseek.com 时自动复用 LLM_API_KEY。
# 改用其他对话服务商时，在下面单独填 DeepSeek Key。所有 Key 只用于服务端。
# WEB_SEARCH_ENABLED=true
# DEEPSEEK_SEARCH_API_KEY=
# 设置 WEB_SEARCH_ENABLED=false 可关闭；演示模式不调用联网接口。
# 官方协议：https://api-docs.deepseek.com/zh-cn/guides/search/

# ============ 识图模型（拍通知、拍课表用；留空则不支持图片） ============
VISION_MODEL=deepseek-flash
# 默认和对话模型用同一个服务商（也沿用 LLM_EXTRA_BODY）；不同的话单独填：
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_EXTRA_BODY=

# ============ 嵌入模型（语义检索；留空则只用关键词检索） ============
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# 一次请求送几段，默认：硅基流动 32、其他 10
# EMBEDDING_BATCH_SIZE=32

# ============ 重排模型（给候选资料精排；留空则不重排） ============
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# 默认和嵌入模型用同一个服务商；不同的话单独填：
# RERANK_BASE_URL=
# RERANK_API_KEY=
# 重排相关度低于这个值，判定"资料里没有答案"
# RERANK_MIN_SCORE=0.3

# 其他服务商示例（模型名以各家控制台为准）：
#   阿里云百炼：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#              LLM_MODEL=qwen-plus  VISION_MODEL=qwen-vl-plus  EMBEDDING_MODEL=text-embedding-v4
#              （百炼的重排接口格式不同，暂不支持）

# ============ 管理后台 ============
# 高德 Web端（JS API）Key 与配套安全密钥；安全密钥只用于服务端代理。
AMAP_JS_API_KEY=
AMAP_SECURITY_JSCODE=

# 设置后才能登录 /admin；留空则后台关闭。请用足够长的随机密码
ADMIN_PASSWORD=

# ============ 可选：排队与限流 ============
# 全站：滚动一分钟最多开始处理的提问数（保护模型额度）、同时处理数、等待队列上限
# CHAT_RATE_LIMIT=60
# CHAT_CONCURRENCY=8
# CHAT_QUEUE_CAPACITY=100
# 每个浏览器滚动一分钟最多提问次数；同一公网出口（校园网、现场 Wi-Fi 共用）同时排队和处理中的上限
# CHAT_CLIENT_RATE_LIMIT=6
# CHAT_IP_ACTIVE_LIMIT=40
# 决赛现场观众扫码互动时建议调成：
#   CHAT_RATE_LIMIT=120  CHAT_CONCURRENCY=10  CHAT_QUEUE_CAPACITY=150  CHAT_IP_ACTIVE_LIMIT=150

# ============ 可选 ============
# 没有重排时的语义相似度阈值：低于它且关键词也对不上，就判定"资料里没有"
# KB_MIN_SIMILARITY=0.45
# 数据和知识库目录
# DATA_DIR=./data
# KNOWLEDGE_DIR=./knowledge
